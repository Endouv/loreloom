# Loreloom environment configuration
# Copy this file to .env only if you need to override defaults.
# Loreloom is local-first: no API keys, no accounts, no cloud.

# HTTP port for the local server (client dev server proxies to it).
LORELOOM_PORT=4747

# Where the SQLite database and rolling backups live.
# Defaults to ./server/data (gitignored). Useful for tests or portable installs.
# LORELOOM_DATA_DIR=/absolute/path/to/data

# Ollama base URL. Defaults to http://localhost:11434.
# LORELOOM_OLLAMA_URL=http://localhost:11434

# Models are chosen in the app (Settings -> Models), not via environment
# variables: the app discovers what your Ollama installation actually has.
# Recommended: main = a capable instruct model, light = a small fast model,
# embedding = nomic-embed-text (see README).
